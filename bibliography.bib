@article{kohn_analytic_1959,
  title    = {Analytic {Properties} of {Bloch} {Waves} and {Wannier} {Functions}},
  volume   = {115},
  url      = {https://link.aps.org/doi/10.1103/PhysRev.115.809},
  doi      = {10.1103/PhysRev.115.809},
  abstract = {The one-dimensional Schrödinger equation with a periodic and symmetric potential is considered, under the assumption that the energy bands do not intersect. The Bloch waves, ϕn,k, and energy bands, En,k, are studied as functions of the complex variable, k. In the complex plane, they are branches of multivalued analytic and periodic functions, ϕk, and Ek, with branch points, k′, off the real axis. A simple procedure is described for locating the branch points. Application is made to the power series and Fourier series developments of these functions. The analyticity and periodicity of ϕn,k has some consequences for the form of the Wannier functions. In particular, it is shown that for each band there exists one and only one Wannier function which is real, symmetric or antisymmetric under an appropriate reflection, and falling off exponentially with distance. The rate of falloff is determined by the distance of the branch points k′ from the real axis.},
  number   = {4},
  urldate  = {2020-07-07},
  journal  = {Phys. Rev.},
  author   = {Kohn, W.},
  month    = aug,
  year     = {1959},
  note     = {Publisher: American Physical Society},
  pages    = {809--821},
  file     = {APS Snapshot:/Users/perudornellas/Zotero/storage/B2SUDYKF/PhysRev.115.html:text/html}
}

