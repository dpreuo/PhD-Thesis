@article{resta_macroscopic_1999,
  title     = {Macroscopic polarization from electronic wave functions},
  author    = {Resta, R.},
  year      = 1999,
  journal   = {International Journal of Quantum Chemistry},
  volume    = 75,
  number    = {4-5},
  pages     = {599--606},
  doi       = {10.1002/(SICI)1097-461X(1999)75:4/5<599::AID-QUA25>3.0.CO;2-8},
  issn      = {1097-461X},
  url       = {https://onlinelibrary.wiley.com/doi/abs/10.1002/%28SICI%291097-461X%281999%2975%3A4/5%3C599%3A%3AAID-QUA25%3E3.0.CO%3B2-8},
  urldate   = {2020-06-23},
  copyright = {Copyright © 1999 John Wiley \& Sons, Inc.},
  abstract  = {The dipole moment of any finite and neutral system, having a square-integrable wave function, is a well-defined quantity. The same quantity is ill-defined for an extended system, whose wave function invariably obeys periodic (Born–von Kármán) boundary conditions. Despite this fact, macroscopic polarization is a theoretically accessible quantity, for either uncorrelated or correlated many-electron systems: in both cases, polarization is a rather “exotic” observable. For an uncorrelated—either Hartree–Fock or Kohn–Sham—crystalline solid, polarization has been expressed and computed as a Berry phase of the Bloch orbitals (since 1993). The case of a correlated and/or disordered system received a definitive solution only very recently (1998): This latest development allows us to present here the whole theory from a novel, and very general, viewpoint. The modern theory of polarization is even relevant to the foundations of density functional theory in extended systems. ©1999 John Wiley \& Sons, Inc. Int J Quant Chem 75: 599–606, 1999},
  language  = {en},
  keywords  = {dielectric polarization, ferroelectricity, piezoelectricity},
  file      = {Snapshot:/Users/perudornellas/Zotero/storage/JVMHC9NZ/5599AID-QUA253.0.html:text/html;Submitted Version:/Users/perudornellas/Zotero/storage/S7G478GD/Resta - 1999 - Macroscopic polarization from electronic wave func.pdf:application/pdf}
}
