@article{adiga_skew_2010,
  title    = {The skew energy of a digraph},
  author   = {Adiga, C. and Balakrishnan, R. and So, Wasin},
  year     = 2010,
  month    = mar,
  journal  = {Linear Algebra and its Applications},
  volume   = 432,
  number   = 7,
  pages    = {1825--1835},
  doi      = {10.1016/j.laa.2009.11.034},
  issn     = {0024-3795},
  url      = {https://www.sciencedirect.com/science/article/pii/S0024379509006144},
  urldate  = {2022-05-06},
  abstract = {We are interested in the energy of the skew-adjacency matrix of a directed graph D, which is simply called the skew energy of D in this paper. Properties of the skew energy of D are studied. In particular, a sharp upper bound for the skew energy of D is derived in terms of the order of D and the maximum degree of its underlying undirected graph. An infinite family of digraphs attaining the maximum skew energy is constructed. Moreover, the skew energy of a directed tree is independent of its orientation, and interestingly it is equal to the energy of the underlying undirected tree. Skew energies of directed cycles under different orientations are also computed. Some open problems are presented.},
  language = {en},
  keywords = {Conference matrices, Digraph, Skew energy, Skew-adjacency matrix},
  file     = {ScienceDirect Full Text PDF:/Users/perudornellas/Zotero/storage/IEIGZTJI/Adiga et al. - 2010 - The skew energy of a digraph.pdf:application/pdf;ScienceDirect Snapshot:/Users/perudornellas/Zotero/storage/VW7YYCL4/S0024379509006144.html:text/html}
}
