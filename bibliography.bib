@article{cloizeaux_energy_1964,
  title      = {Energy {Bands} and {Projection} {Operators} in a {Crystal}: {Analytic} and {Asymptotic} {Properties}},
  volume     = {135},
  shorttitle = {Energy {Bands} and {Projection} {Operators} in a {Crystal}},
  url        = {https://link.aps.org/doi/10.1103/PhysRev.135.A685},
  doi        = {10.1103/PhysRev.135.A685},
  abstract   = {In an n-dimensional crystal, an energy band is usually made of several branches which are connected with each other. Accordingly, the Bloch states of wave vector K which are eigenfunctions of a one-electron Hamiltonian H=−Δ+V and which belong to a given band B, define a subspace S(K) of finite dimensionality. For a large class of potentials, two properties concerning the subspaces S(K) which are associated with a fixed band B have been proved for n-dimensional crystals. (1) The projection operator P(K) on S(K) can be defined for complex values of K, and its matrix elements ⟨r{\textbar}P(K){\textbar}r′⟩ are analytic in a strip of the complex K space; this strip is centered on the real K space and is independent of r and r'. (2) The projection operator P=∫dhKP(K) (integration on the Brillouin zone) has matrix elements ⟨r{\textbar}P{\textbar}r′⟩ which decrease exponentially when the length{\textbar}r-r′{\textbar} goes to infinity.},
  number     = {3A},
  urldate    = {2020-07-07},
  journal    = {Phys. Rev.},
  author     = {Cloizeaux, J Des},
  month      = aug,
  year       = {1964},
  note       = {Publisher: American Physical Society},
  pages      = {A685--A697},
  file       = {APS Snapshot:/Users/perudornellas/Zotero/storage/95X9LEDF/PhysRev.135.html:text/html;Full Text PDF:/Users/perudornellas/Zotero/storage/K39RFPT9/Cloizeaux - 1964 - Energy Bands and Projection Operators in a Crystal.pdf:application/pdf}
}


@article{contreras_berry_2008,
  title    = {Berry phases, quantum phase transitions and {Chern} numbers},
  volume   = {403},
  issn     = {0921-4526},
  url      = {http://www.sciencedirect.com/science/article/pii/S0921452607011313},
  doi      = {10.1016/j.physb.2007.10.131},
  abstract = {We study the relation between Chern numbers and quantum phase transitions (QPT) in the XY spin-chain model. By coupling the spin chain to a single spin, it is possible to study topological invariants associated to the coupling Hamiltonian. These invariants contain global information, in addition to the usual one (obtained by integrating the Berry connection around a closed loop). We compute these invariants (Chern numbers) and discuss their relation to QPT. In particular we show that Chern numbers can be used to label regions corresponding to different phases.},
  language = {en},
  number   = {5},
  urldate  = {2019-11-04},
  journal  = {Physica B: Condensed Matter},
  author   = {Contreras, H. A. and Reyes-Lega, A. F.},
