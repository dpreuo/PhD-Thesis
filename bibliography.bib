@article{chalker_percolation_1988,
  title    = {Percolation, quantum tunnelling and the integer {Hall} effect},
  author   = {Chalker, J. T. and Coddington, P. D.},
  year     = 1988,
  month    = may,
  journal  = {Journal of Physics C: Solid State Physics},
  volume   = 21,
  number   = 14,
  pages    = 2665,
  doi      = {10.1088/0022-3719/21/14/008},
  url      = {https://dx.doi.org/10.1088/0022-3719/21/14/008},
  abstract = {A model is introduced for Anderson localisation in the integer quantum Hall regime. The model represents a system with a disordered potential that varies slowly on the scale of the magnetic length, but includes quantum tunnelling and interference effects. Numerical calculations indicate that the localisation length diverges only at the centre of each Landau band. The scaling behaviour near the mobility edge is analysed: results suggest that quantum tunnelling induces crossover at the classical percolation threshold to critical behaviour similar to that found previously for a rapidly varying potential.}
}
