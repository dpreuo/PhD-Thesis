@article{lieb_ordering_1962,
  author   = {Lieb, Elliott and Mattis, Daniel},
  title    = {{Ordering Energy Levels of Interacting Spin Systems}},
  journal  = {Journal of Mathematical Physics},
  volume   = {3},
  number   = {4},
  pages    = {749-751},
  year     = {1962},
  month    = {12},
  abstract = {{The total spin S is a good quantum number in problems of interacting spins. We have shown that for rather general antiferromagnetic or ferrimagnetic Hamiltonians, which need not exhibit translational invariance, the lowest energy eigenvalue for each value of S [denoted E(S) ] is ordered in a natural way. In antiferromagnetism, E(S + 1) \\&gt; E(S) for S ≥ 0. In ferrimagnetism, E(S + 1) \\&gt; E(S) for S≥S, and in addition the ground state belongs to S≤S. S is defined as follows: Let the maximum spin of the A sublattice be SA and of the B sublattice SB; then S≡|SA−SB|. Antiferromagnetism is treated as the special case of S=0. We also briefly discuss the structure of the lowest eigenfunctions in an external magnetic field.}},
  issn     = {0022-2488},
  doi      = {10.1063/1.1724276},
  url      = {https://doi.org/10.1063/1.1724276}
}
